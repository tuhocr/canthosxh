                     )) +

  geom_col(show.legend = F,
            colour = "black",
           fill = "yellow",
           width = 0.7,
           linewidth = 0.1) +

  geom_text(show.legend = F,
            colour = "blue",
            mapping = aes(label = COUNT),
            vjust = -1,
            size = 3,
            fontface = 2) +

