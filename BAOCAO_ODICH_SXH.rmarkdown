# **ĐỒ THỊ TỔNG SỐ CA THEO THỜI GIAN**



```{r}
stat_day_df_MONTH_ORI_CHUAN |> dplyr:::group_by(TTYTKV, MONTH) |> 
  dplyr:::summarise(SUM_MONTH = sum(COUNT)) |> as.data.frame() -> stat_day_df_MONTH_ORI_YES

saveRDS(stat_day_df_MONTH_ORI_YES, "stat_day_df_MONTH_ORI_YES.rds")
```

```{r, fig.width=10, fig.height=12}
library(ggplot2)

stat_day_df_MONTH_ORI_YES <- readRDS("stat_day_df_MONTH_ORI_YES.rds")

stat_day_df_MONTH_ORI_YES |> dplyr:::group_by(TTYTKV) |> dplyr:::summarise(TOTAL = sum(SUM_MONTH)) |> 
  as.data.frame() |> dplyr:::arrange(desc(TOTAL)) -> stat_day_df_MONTH_ORI_YES_TOTAL

stat_day_df_MONTH_ORI_YES$TTYTKV <- factor(stat_day_df_MONTH_ORI_YES$TTYTKV,
                                           levels = stat_day_df_MONTH_ORI_YES_TOTAL$TTYTKV)

ggplot(data = stat_day_df_MONTH_ORI_YES,
       mapping = aes(x = MONTH,
                     y = SUM_MONTH)) +
  geom_point(color = "yellow3") +
  
  geom_line(color = "yellow3") +
  
  scale_x_continuous(breaks = seq(1,12,1)) +
  
  scale_y_continuous(
    # breaks = seq(0,500,50),
                     limits = c(0, max(stat_day_df_MONTH_ORI_YES$SUM_MONTH)*1.2)) +
  
    geom_text(aes(label = SUM_MONTH),
              vjust = -1,
              size = 2.5,
              color = "blue") +
  
  # geom_col() +
  
  facet_wrap(~ TTYTKV,
             ncol = 4) +
  
  theme_bw(base_size = 14) +
  
  theme(panel.grid.minor = element_blank()) + 
  
  labs(title = "Tổng số ca ghi nhận tại mỗi tháng") +
  
  xlab("Tháng") +
  
  ylab("Số ca nhập viện") 
```

```{r}
library(dplyr)
# row.names(stat_day_df_MONTH_ORI_YES) <- paste0(stat_day_df_MONTH_ORI_YES$TTYTKV, "_", stat_day_df_MONTH_ORI_YES$MONTH)

stat_day_df_MONTH_ORI_YES$TTYTKV <- as.character(stat_day_df_MONTH_ORI_YES$TTYTKV)

index_ttytkv <- unique(stat_day_df_MONTH_ORI_YES$TTYTKV)

ttyt_cumsum <- list()

for(w in 1:length(index_ttytkv)){
  
trich_ttytkv <- stat_day_df_MONTH_ORI_YES |> subset(TTYTKV == index_ttytkv[w])

trich_ttytkv$CUMSUM <- cumsum(trich_ttytkv$SUM_MONTH)

ttyt_cumsum[[w]] <- trich_ttytkv
}

stat_day_df_MONTH_ORI_CUMSUM <- do.call(rbind, ttyt_cumsum)
```

```{r, fig.width=10, fig.height=12}
stat_day_df_MONTH_ORI_CUMSUM$TTYTKV <- factor(stat_day_df_MONTH_ORI_CUMSUM$TTYTKV,
                                           levels = stat_day_df_MONTH_ORI_YES_TOTAL$TTYTKV)

ggplot(data = stat_day_df_MONTH_ORI_CUMSUM,
       mapping = aes(x = MONTH,
                     y = CUMSUM)) +
  geom_point(color = "red") +
  
  geom_line(color = "red") +
  
  scale_x_continuous(breaks = seq(1,12,1)) +
  
  scale_y_continuous(
    # breaks = seq(0,5000,300),
                     limits = c(0, max(stat_day_df_MONTH_ORI_CUMSUM$CUMSUM)*1.2)) +
  
     geom_text(aes(label = CUMSUM),
              vjust = -1,
              size = 2.5,
              color = "blue") +
  
  facet_wrap(~ TTYTKV,
             ncol = 4) +
  
  theme_bw(base_size = 14) +
  
  theme(panel.grid.minor = element_blank()) + 
  
  labs(title = "Tổng số ca tích lũy theo thời gian") +
  
   xlab("Tháng") +
  
  ylab("Số ca nhập viện") 
```





# **TỔNG SỐ CA THEO TUẦN**



```{r}
library(lubridate)
df_SXH$WEEK <- lubridate:::week(df_SXH$NGAY_VV)

df_SXH$MONTH <- lubridate:::month(df_SXH$NGAY_VV)

df_SXH$YEAR <- lubridate:::year(df_SXH$NGAY_VV)
```

```{r}
table(df_SXH$TTYTKV,
      df_SXH$PHUONG_XA_MOI,
      df_SXH$WEEK) -> stat_day

as.data.frame(stat_day) -> stat_day_df

names(stat_day_df) <- c("TTYTKV", "PHUONG_XA_MOI", "WEEK", "COUNT")

stat_day_df$TTYTKV <- as.character(stat_day_df$TTYTKV)

stat_day_df$PHUONG_XA_MOI <- as.character(stat_day_df$PHUONG_XA_MOI)

stat_day_df$WEEK <- as.character(stat_day_df$WEEK)

stat_day_df$WEEK <- as.numeric(stat_day_df$WEEK)

stat_day_df |> dplyr:::arrange(desc(TTYTKV),
                               desc(PHUONG_XA_MOI),
                               WEEK)  -> stat_day_df_final
```

```{r}
stat_day_WEEK <- stat_day_df |> subset(COUNT != 0)

stat_day_WEEK -> stat_day_WEEK_ORI
```

```{r, results='hold'}

library(DT)

DT:::datatable(
